rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAnonymous() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    
    function isAuthenticatedOrAnonymous() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == 'info@indiannaturalhair.com' ||
              request.auth.token.email == 'info@praveenasok.com' ||
              request.auth.token.admin == true);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Public read access for products and config (for unauthenticated users)
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allow service account access for sync and admin interface
    }
    
    match /orderlist/{document=**} {
      allow read, write: if true;
    }
    
    match /config/{configId} {
      allow read: if true;
      allow write: if true; // Allow admin interface access
    }
    
    // Allow public access for admin interface (consolidated salesmen rule)
    
    // Admin-only collections for data management
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /uploads/{uploadId} {
      allow read, write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
    
    // User-specific collections - allow public read for admin dashboard stats
    match /clients/{clientId} {
      allow read: if true; // Allow public read for dashboard statistics
      allow write: if isAuthenticated();
    }
    
    match /quotes/{quoteId} {
      allow read, write: if true; // Allow public access for quotes functionality
    }

    match /orders/{orderId} {
      allow read, write: if true; // Allow public access for orders functionality
    }

    match /proforma_invoices/{invoiceId} {
      allow read, write: if true; 
    }

    match /address_book/{addressId} {
      allow read, write: if true; 
    }

    // Salespeople data - allow public access for admin interface
    match /salespeople/{salespersonId} {
      allow read, write: if true; // Allow public access for admin interface
    }

    // Legacy Salesmen collection - allow public access for dropdowns
    match /salesmen/{salesmanId} {
      allow read: if true; // Enable INHDATA prime/subscribe for salesmen
      allow write: if true; // Allow admin/service account syncs
    }
    
    // Colors collection - allow public read for admin dashboard stats
    match /colors/{colorId} {
      allow read: if true; // Allow public read for dashboard statistics
      allow write: if true; // Allow service account access for sync
    }
    
    // Styles collection - allow public read for admin dashboard stats
    match /styles/{styleId} {
      allow read: if true; // Allow public read for dashboard statistics
      allow write: if true; // Allow service account access for sync
    }
    
    // PriceLists collection - allow public read for shades and pricing data
    match /priceLists/{priceListId} {
      allow read: if true; // Allow public read for shades counting and pricing
      allow write: if true; // Allow service account access for sync
    }

    // Legacy lowercase 'pricelists' collection access (used by some pages)
    match /pricelists/{priceListId} {
      allow read: if true;
      allow write: if true;
    }

    // Products collection access for diagnostics and legacy listeners
    match /products/{productId} {
      allow read: if true; // Enable real-time listener tests and legacy reads
      allow write: if true; // Allow service account/admin syncs
    }

    // Removed INH Pricelists rules: use legacy 'pricelists' or product-derived data
    
    // INH Colors collection (new canonical)
    match /inh_colors/{colorId} {
      allow read: if true; // Allow public read for dropdowns and stats
      allow write: if true; // Allow service account/admin syncs
    }
    
    // INH Styles collection (new canonical)
    match /inh_styles/{styleId} {
      allow read: if true; // Allow public read for dropdowns and stats
      allow write: if true; // Allow service account/admin syncs
    }
    
    // INH Salesmen collection (new canonical)
    match /inh_salesmen/{salesmanId} {
      allow read: if true; // Allow public read for dropdowns
      allow write: if true; // Allow service account/admin syncs
    }
    
    // Company collection for brand/company config used by INHDATA
    match /company/{companyId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Sync logs - allow service account access
    match /sync_logs/{logId} {
      allow read, write: if true; // Allow service account access
    }
    
    // Storage collection for localStorage replacement
    match /storage/{storageId} {
      allow read, write: if true; // Allow public access for localStorage replacement
    }
    
    // Ratio Mixer collection for syncing settings
    match /ratioMixer/{document=**} {
      allow read, write: if true; // Allow public access for shared settings sync
    }

    // QR Code scan tracking data
    match /inv_qr_scans/{scanId} {
      allow read, write: if true;
    }
    
    // QR Code tags data
    match /inv_qr_codes/{qrId} {
      allow read, write: if true;
    }

    match /inv_qr_tags/{tagId} {
      allow read, write: if true;
    }
    
    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Application settings (Access Control)
    match /app_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Payroll System collections
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    match /salary_records/{recordId} {
      allow read, write: if true;
    }
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }
    match /official_holidays/{holidayId} {
      allow read, write: if true;
    }
    match /leave_plans/{planId} {
      allow read, write: if true;
    }
    
    // Hair Stock and Suppliers
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /hairStockEntries/{entryId} {
      allow read, write: if true;
    }
    match /warehouseStockEntries/{entryId} {
      allow read, write: if true;
    }
    match /warehouses/{warehouseId} {
      allow read, write: if true;
    }
    
    // Quick Price List
    match /quick_price_list/{itemId} {
      allow read, write: if true;
    }
    
    // Application Data sync
    match /workspace_data/{document=**} {
      allow read, write: if true;
    }
    match /jobwork_data/{document=**} {
      allow read, write: if true;
    }
    
    // Job Billing Data
    match /job_billing_orders/{document=**} {
      allow read, write: if true;
    }
    match /job_billing_payments/{document=**} {
      allow read, write: if true;
    }
    
    // Global fallback: Allow read/write for all to permanently solve permission issues as requested
    match /{document=**} {
      allow read, write: if true;
    }
  }
}