rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions for authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == 'info@indiannaturalhair.com' ||
              request.auth.token.admin == true);
    }
    
    function isAdminEmail() {
      return isAuthenticated() && request.auth.token.email == 'info@indiannaturalhair.com';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    

    
    function isValidImageFile() {
      return request.resource.contentType.lower().matches('image/.*') ||
             request.resource.name.lower().matches('.*\\.(jpg|jpeg|png|gif|webp|svg)$');
    }
    
    // Public read access for product images
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageFile();
    }
    
    // Public assets (like company logos)
    match /public_assets/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    
    // Reference images for delegated orders (root level)
    match /orders/{sheetId}/{orderId}/{fileName} {
      allow read: if true;
      allow write: if isValidImageFile();
    }
    
    // Reference images for delegated orders (nested column level)
    match /orders/{sheetId}/{orderId}/{columnName}/{fileName} {
      allow read: if true;
      allow write: if isValidImageFile();
    }

    // User-specific client documents (allow anonymous users)
    match /clients/{clientId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // User-specific quote exports (allow anonymous users)
    match /quotes/{quoteId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Proforma Invoice exports
    match /proforma_exports/{invoiceId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() || true; // allow unauth for now given typical usage in this codebase
    }
    
    // Admin-only data sync and backup files
    match /sync/{fileName} {
      allow read: if isAdminEmail() || isAdmin();
      allow write: if (isAdminEmail() || isAdmin()) && 
                      request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    // Admin-only backup files
    match /backups/{fileName} {
      allow read, write: if isAdmin();
    }
    
    // User profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if (isOwner(userId) || isAdmin()) && isValidImageFile();
    }
    
    // Payroll documents
    match /payroll_documents/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    
    // Employee profile pictures
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    
    // Employee UPI QR Codes
    match /upi_qrcodes/{fileName} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}